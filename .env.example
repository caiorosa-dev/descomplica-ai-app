# Banco de dados (dentro do Docker Compose o host é "postgres")
DATABASE_URL=postgresql://app:app@postgres:5432/app
# Banco dos testes de integração (Postgres do compose, acessado pelo host)
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/app_test
# Porta do Postgres no host (mude se a 5432 já estiver em uso)
POSTGRES_PORT=5432

# Providers de IA
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Arquivos enviados e corpus
UPLOAD_DIR=/data/uploads
CORPUS_DIR=./corpus

# Concorrência
RUN_CONCURRENCY=2
LLM_CONCURRENCY=4

# API
PORT=3333
LOG_LEVEL=info
